<Window x:Class="ProShitje.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProShitje 2.0 — WPF" Width="1500" Height="920" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F7FC" FontFamily="Segoe UI" KeyDown="Window_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="490"/></Grid.ColumnDefinitions>
  <!-- Sidebar -->
  <Border Grid.Column="0" Background="#102B4E">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="20,22,14,26"><TextBlock Text="🛒  ProShitje" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="VERSION 2.0 · WPF" Foreground="#AFC5E1" FontSize="11" Margin="4,5,0,0"/></StackPanel>
    <StackPanel>
     <Button Content="🛒   Shitje" Background="#0866D6" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="22,16" FontWeight="SemiBold"/>
     <Button Content="▣   Artikuj" Style="{x:Null}" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
     <Button Content="▦   Stok" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
     <Button Content="🚚   Furnizime" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
     <Button Content="♙   Klientë" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
     <Button Content="▥   Raporte" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
     <Button x:Name="SettingsButton" Content="⚙   Cilësime" Click="Settings_Click" Background="Transparent" Foreground="#E7F0FB" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="22,14"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,10,12,20"><TextBlock x:Name="ConnectionStatus" Text="●  MDB e pakonfiguruar" Foreground="#FFD166" FontSize="12" Margin="0,0,0,22"/><TextBlock Text="F5  Skedar fiskal" Foreground="White" Margin="0,3"/><TextBlock Text="F6  Ruaj faturën" Foreground="White" Margin="0,3"/><TextBlock Text="F7  Printo faturën" Foreground="White" Margin="0,3"/><TextBlock Text="© ProShitje" Foreground="#829CB9" FontSize="11" Margin="0,20,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <!-- Product catalog -->
  <Grid Grid.Column="1" Margin="18,16,14,16">
   <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="10" Padding="12,2" Margin="0,0,10,0"><DockPanel><TextBlock Text="⌕" FontSize="28" Foreground="#0866D6" VerticalAlignment="Center" Margin="2,0,12,0"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="16" ToolTip="Kërko me emër, barkod ose kod" TextChanged="SearchBox_TextChanged"/></DockPanel></Border><Button Grid.Column="1" Content="Skanim ▥" Background="#E3EEFC" Foreground="#0757B8" Click="Scan_Click"/></Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Të gjitha" Background="#0866D6" Foreground="White" Margin="0,0,8,0"/><Button Content="Ushqimore" Margin="0,0,8,0"/><Button Content="Pije" Margin="0,0,8,0"/><Button Content="Higjienë" Margin="0,0,8,0"/><Button Content="Shtëpiake" Margin="0,0,8,0"/><Button Content="Të tjera"/></StackPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="ProductPanel" ItemWidth="150" /></ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="CatalogFooter" Text="Zgjidh MDB te Cilësimet për të ngarkuar artikujt." Foreground="#6D8099" VerticalAlignment="Center" FontSize="11"/>
  </Grid>
  <!-- Invoice -->
  <Border Grid.Column="2" Background="White" BorderBrush="#E0E8F2" BorderThickness="1" CornerRadius="14" Margin="0,16,16,16">
   <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="54"/><RowDefinition Height="60"/><RowDefinition Height="80"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="🛒  Fatura #000125" FontSize="23" FontWeight="Bold" Foreground="#102B4E" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Të drejtat" Margin="0,0,6,0" Padding="8,6" Click="Permissions_Click" ToolTip="Konfigurimi i PIN-it dhe të drejtave"/><Button Content="Pastro" Background="#FFE7E8" Foreground="#D72F3B" Padding="14,8" Click="ClearInvoice_Click"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Klienti:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#526782"/><TextBox Grid.Column="1" x:Name="CustomerBox" Text="Klient cash" Padding="10,6"/></Grid>
    <DataGrid Grid.Row="2" x:Name="InvoiceGrid" ItemsSource="{Binding InvoiceLines}" Margin="0,8,0,10" CanUserResizeRows="False" CanUserSortColumns="False" SelectionChanged="InvoiceGrid_SelectionChanged">
     <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="28"/><DataGridTextColumn Header="Artikulli" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="95"/><DataGridTextColumn Header="Njësia" Binding="{Binding Unit}" IsReadOnly="True" Width="58"/><DataGridTemplateColumn Header="Sasia" Width="78">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="2" PreviewKeyDown="QuantityBox_PreviewKeyDown" LostFocus="QuantityBox_LostFocus"/><Button Grid.Column="1" Content="⌨" Padding="1" ToolTip="Tastierë me prekje" Click="QuantityKeypad_Click"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn><DataGridTemplateColumn Header="Çmimi" Width="76">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Price, StringFormat=N2}" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="2" ToolTip="Kliko me të djathtën për ndryshim çmimi (kërkon autorizim)" MouseRightButtonUp="PriceCell_MouseRightButtonUp"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn><DataGridTextColumn Header="Totali" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="75"/><DataGridTemplateColumn Header="" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Padding="4,2" Background="#FFE7E8" Foreground="#D72F3B" Click="RemoveLine_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#E3EAF3" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Nëntotali" Foreground="#526782"/><TextBlock x:Name="SubtotalText" Text="0,00 lekë" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Zbritje (%)" Foreground="#526782"/><TextBox x:Name="DiscountBox" Text="0" Width="90" Padding="8,4" HorizontalAlignment="Right" TextChanged="DiscountBox_TextChanged"/></DockPanel><DockPanel><TextBlock Text="TOTALI" FontSize="18" FontWeight="Bold" Foreground="#102B4E"/><TextBlock x:Name="TotalText" Text="0,00 lekë" FontSize="25" FontWeight="Bold" Foreground="#102B4E" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel></StackPanel></Border>
    <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,8"><Button Content="Cash" Background="#0866D6" Foreground="White" Margin="0,0,6,0" Click="Cash_Click"/><Button Content="Kartë" Margin="3,0" Click="Card_Click"/><Button Content="Tjetër" Margin="6,0,0,0" Click="OtherPayment_Click"/></UniformGrid>
    <Button Grid.Row="5" Content="✓   Përfundo pagesën (F6)" Background="#079A5B" Foreground="White" FontSize="17" FontWeight="SemiBold" Click="SaveInvoice_Click" Margin="0,0,0,8"/>
    <UniformGrid Grid.Row="6" Columns="3"><Button Content="▤\nSkedar fiskal (F5)" FontSize="12" Margin="0,0,5,0" Click="Fiscal_Click"/><Button Content="▣\nRuaj faturën (F6)" FontSize="12" Margin="3,0" Click="SaveInvoice_Click"/><Button Content="▣\nPrinto (F7)" FontSize="12" Margin="5,0,0,0" Click="Print_Click"/></UniformGrid>
   </Grid>
  </Border>
 </Grid>
</Window>
