<Window x:Class="ProShitjeLicensing.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProShitje - Aktivizimi" Height="650" Width="820" MinHeight="600" MinWidth="760" WindowStartupLocation="CenterScreen" Background="#F2F6FB" FontFamily="Segoe UI">
<Grid><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Background="#142E50" Padding="24"><StackPanel><TextBlock Text="ProShitje" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="REGJISTRIMI DHE AKTIVIZIMI I LICENCËS" Foreground="#C7D8EF"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><TextBlock Text="Identifikimi i pajisjes" FontSize="20" FontWeight="SemiBold" Foreground="#142E50" Margin="0,0,0,14"/><TextBlock Text="Seriali i diskut / identifikuesi" FontWeight="SemiBold"/><TextBox x:Name="SsdSerialBox" IsReadOnly="True" TextWrapping="Wrap" Padding="10" Margin="0,5,0,12" Background="#E8EEF6"/><TextBlock Text="N1" FontWeight="SemiBold"/><TextBox x:Name="N1Box" IsReadOnly="True" FontSize="18" Padding="10" Margin="0,5,0,12" Background="#E8EEF6"/><TextBlock Text="N2" FontWeight="SemiBold"/><TextBox x:Name="N2Box" IsReadOnly="True" FontSize="18" Padding="10" Margin="0,5,0,12" Background="#E8EEF6"/><Button Content="Rilexo pajisjen" Height="42" Click="RefreshButton_Click"/><TextBlock Text="Dërgo N1 dhe N2 administratorit për llogaritjen e serialit." TextWrapping="Wrap" Foreground="#58677A" Margin="0,12,0,0"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Aktivizimi" FontSize="20" FontWeight="SemiBold" Foreground="#142E50" Margin="0,0,0,14"/><TextBlock Text="Seriali i licencës" FontWeight="SemiBold"/><TextBox x:Name="LicenseKeyBox" FontSize="18" Padding="10" Margin="0,5,0,14"/><TextBlock Text="Databaza Access (.mdb)" FontWeight="SemiBold"/><DockPanel Margin="0,5,0,14"><Button Content="Zgjidh..." Width="90" Height="38" DockPanel.Dock="Right" Click="BrowseDb_Click" Margin="8,0,0,0"/><TextBox x:Name="DbPathBox" Padding="9" VerticalContentAlignment="Center"/></DockPanel><TextBlock Text="Kohëzgjatja" FontWeight="SemiBold"/><ComboBox x:Name="DurationBox" FontSize="15" Padding="7" Margin="0,5,0,12" SelectedIndex="0"><ComboBoxItem Content="1 vit" Tag="12"/><ComboBoxItem Content="2 vite" Tag="24"/><ComboBoxItem Content="3 vite" Tag="36"/></ComboBox><Button Content="AKTIVIZO LICENCËN" Height="50" FontSize="16" FontWeight="Bold" Foreground="White" Background="#079455" Click="ActivateButton_Click"/><Border Background="White" BorderBrush="#D7E1EE" BorderThickness="1" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="Statusi" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Programi nuk është aktivizuar." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></Grid>
<Border Grid.Row="2" Background="#E2EAF4" Padding="12,7"><TextBlock Text="ProShitje Licensing Starter • Aktivizim offline" Foreground="#53657A" FontSize="11"/></Border></Grid></Window>